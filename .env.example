# Copy to .env.local (local) or set in your hosting provider (production).
# All NEXT_PUBLIC_* values are baked into the browser bundle at build time,
# so rebuild after changing them. Never put secret keys here.

# Backend base URL (without /api/v1)
NEXT_PUBLIC_API_URL=https://api.flonxapp.com

# Stripe publishable key, same account and mode as the backend's secret key
# (pk_live_... in production, pk_test_... for testing)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google Maps JavaScript API key with the Places library (venue search).
# Restrict it to your site's domain in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# "Join now" page links (optional; these are the defaults)
NEXT_PUBLIC_BARTENDER_DASHBOARD_URL=https://bartender.flonxapp.com
NEXT_PUBLIC_VENUE_DASHBOARD_URL=https://venue.flonxapp.com
